module

public import New.UpperBound.ElementaryDivisors.TwistingData

/-!
# An adjacent Frobenius pairing for the edge Hecke operator

Research module, outside the production import graph. The modulus is the principal
ideal generated by the rational prime, not the maximal ideal of the coefficient ring.
-/

@[expose] public section

noncomputable section

namespace New.FrobeniusCycle

open Matrix MvPolynomial Finset Finsupp Ideal

variable {N k : ℕ} [NeZero N] {W R R' : Type}
  [CommRing W] [IsLocalRing W] [CommRing R] [CommRing R']

/-- The ordinary coefficient polynomial of one adjacent Frobenius contraction. -/
def adjacentPairing (T : FrobeniusCycle N W R) (s : ZMod N) :
    MvPolynomial (Fin k × ZMod N) R :=
  ∑ b : Fin k, X (b, s) ^ T.P * X (b, s + 1)

omit [NeZero N] in
/-- Adjacent letters are distinct, since their parities differ. -/
lemma adjacent_ne (T : FrobeniusCycle N W R) (s : ZMod N) : s + 1 ≠ s := by
  intro h
  have hs := T.isEven_succ s
  rw [h] at hs
  cases T.isEven s <;> simp at hs

omit [NeZero N] in
lemma map_adjacentPairing (T : FrobeniusCycle N W R) (φ : R →+* R') (s : ZMod N) :
    MvPolynomial.map φ (T.adjacentPairing (k := k) s) =
      (T.map φ).adjacentPairing s := by
  simp [adjacentPairing, FrobeniusCycle.map, P]

omit [NeZero N] in
/-- Over characteristic `p`, the neighbouring matrices cancel after Frobenius. -/
lemma letterMatrix_frobenius_mul_succ_transpose (T : FrobeniusCycle N W R)
    [CharP R T.p] (g : GL (Fin k) W) (s : ZMod N) :
    (T.letterMatrix s g).map (fun x : R ↦ x ^ T.P) *
      (T.letterMatrix (s + 1) g)ᵀ = 1 := by
  let : Fact T.p.Prime := ⟨T.prime⟩
  change (T.letterMatrix s g).map (iterateFrobenius R T.p T.frobExp) *
      (T.letterMatrix (s + 1) g)ᵀ = 1
  have hι : T.embedding (s + 1) =
      (iterateFrobenius R T.p T.frobExp).comp (T.embedding s) := by
    ext x
    have h := T.frobenius_congr s x
    simpa only [CharP.cast_eq_zero R T.p, zero_dvd_iff, sub_eq_zero,
      RingHom.comp_apply, iterateFrobenius_def] using h
  let ψ : W →+* R := (iterateFrobenius R T.p T.frobExp).comp (T.embedding s)
  cases hs : T.isEven s <;>
    simp only [letterMatrix_apply, T.isEven_succ, hs, Bool.not_false, Bool.not_true,
      Bool.false_eq_true, ite_false, ite_true, hι, Matrix.map_map,
      GeneralLinearGroup.coe_inv]
  · change (g.val⁻¹.map ψ)ᵀ * (g.val.map ψ)ᵀ = 1
    rw [← Matrix.transpose_mul, GeneralLinearGroup.coe_map_mul_map_inv, transpose_one]
  · change g.val.map ψ * ((g.val⁻¹.map ψ)ᵀ)ᵀ = 1
    rw [transpose_transpose]
    exact GeneralLinearGroup.coe_map_mul_map_inv ψ g

/-- The adjacent contraction is invariant for either orientation of the twisted action,
after reducing the coefficients to characteristic `p`. -/
lemma polyAction_adjacentPairing (T : FrobeniusCycle N W R) [CharP R T.p]
    (g : GL (Fin k) W) (s : ZMod N) :
    T.polyAction g (T.adjacentPairing (k := k) s) = T.adjacentPairing s := by
  let : Fact T.p.Prime := ⟨T.prime⟩
  let A := T.letterMatrix s g
  let B := T.letterMatrix (s + 1) g
  have h_power (v : Fin k → MvPolynomial (Fin k × ZMod N) R) :
      (∑ b, v b) ^ T.P = ∑ b, v b ^ T.P :=
    map_sum (iterateFrobenius _ T.p T.frobExp) v univ
  have h_matrices : A.map (iterateFrobenius R T.p T.frobExp) * Bᵀ = 1 :=
    T.letterMatrix_frobenius_mul_succ_transpose g s
  calc
    T.polyAction g (T.adjacentPairing (k := k) s)
        = ∑ i : Fin k,
            (∑ b : Fin k, C (A b i) * X (b, s)) ^ T.P *
            (∑ b : Fin k, C (B b i) * X (b, s + 1)) := by
          simp [adjacentPairing, polyAction_X, A, B]
    _ = ∑ b : Fin k, ∑ c : Fin k, ∑ i : Fin k,
          C ((A b i) ^ T.P * B c i) * (X (b, s) ^ T.P * X (c, s + 1)) := by
          simp_rw [h_power, Finset.sum_mul, Finset.mul_sum]
          rw [Finset.sum_comm]
          apply Finset.sum_congr rfl
          intro b hb
          rw [Finset.sum_comm]
          apply Finset.sum_congr rfl
          intro c hc
          apply Finset.sum_congr rfl
          intro i hi
          simp only [mul_pow, map_mul, map_pow]
          ring
    _ = ∑ b : Fin k, ∑ c : Fin k,
          C ((A.map (iterateFrobenius R T.p T.frobExp) * Bᵀ) b c) *
            (X (b, s) ^ T.P * X (c, s + 1)) := by
          simp only [Matrix.mul_apply, Matrix.map_apply, transpose_apply,
            iterateFrobenius_def, map_sum, Finset.sum_mul]
    _ = T.adjacentPairing s := by
          rw [h_matrices]
          simp [adjacentPairing, Matrix.one_apply]

/-- Scale each deep variable by the rational prime. -/
def deepScale (T : FrobeniusCycle N W R) (r : ℕ) :
    MvPolynomial (Fin k × ZMod N) R →ₐ[R] MvPolynomial (Fin k × ZMod N) R :=
  aeval fun x ↦ C ((T.p : R) ^ T.deepIndicator r x) * X x

omit [NeZero N] in
@[simp]
lemma deepScale_X (T : FrobeniusCycle N W R) (r : ℕ) (x : Fin k × ZMod N) :
    T.deepScale r (X x) = C ((T.p : R) ^ T.deepIndicator r x) * X x := by
  simp [deepScale]

omit [NeZero N] in
/-- In characteristic `p`, scaling the complementary deep coordinates kills one pairing. -/
lemma deepScale_adjacentPairing (T : FrobeniusCycle N W R) [CharP R T.p]
    (r : ℕ) (s : ZMod N) : T.deepScale r (T.adjacentPairing (k := k) s) = 0 := by
  have hP : T.P ≠ 0 := (lt_of_lt_of_le (by decide : 0 < 5) T.five_le_P).ne'
  simp only [adjacentPairing, map_sum, map_mul, map_pow, deepScale_X]
  apply Finset.sum_eq_zero
  intro b hb
  cases hs : T.isEven s <;> by_cases hbr : r ≤ (b : ℕ) <;>
    simp [deepIndicator, T.isEven_succ, hs, hbr, CharP.cast_eq_zero R T.p,
      zero_pow hP]

lemma map_polyAction (T : FrobeniusCycle N W R) (φ : R →+* R')
    (g : GL (Fin k) W) (f : MvPolynomial (Fin k × ZMod N) R) :
    MvPolynomial.map φ (T.polyAction g f) =
      (T.map φ).polyAction g (MvPolynomial.map φ f) := by
  induction f using MvPolynomial.induction_on with
  | C a => simp
  | add f₁ f₂ h₁ h₂ => simp [h₁, h₂]
  | mul_X f x hf =>
      simp [hf, polyAction_X, letterMatrix_apply, FrobeniusCycle.map]

omit [NeZero N] in
lemma map_deepScale (T : FrobeniusCycle N W R) (φ : R →+* R')
    (r : ℕ) (f : MvPolynomial (Fin k × ZMod N) R) :
    MvPolynomial.map φ (T.deepScale r f) =
      (T.map φ).deepScale r (MvPolynomial.map φ f) := by
  induction f using MvPolynomial.induction_on with
  | C a => simp
  | add f₁ f₂ h₁ h₂ => simp [h₁, h₂]
  | mul_X f x hf =>
      simp only [map_mul, deepScale_X, hf, map_X, map_pow, map_natCast]
      rfl

/-- Multiplying one pairing by any integral polynomial gives a polynomial all of whose
scaled translates have coefficients divisible by `p`. -/
lemma dvd_coeff_deepScale_polyAction_pairing_mul (T : FrobeniusCycle N W R)
    (hp : ¬IsUnit (T.p : R)) (r : ℕ) (s : ZMod N)
    (g : GL (Fin k) W) (f : MvPolynomial (Fin k × ZMod N) R)
    (d : Fin k × ZMod N →₀ ℕ) :
    (T.p : R) ∣ (T.deepScale r (T.polyAction g (T.adjacentPairing s * f))).coeff d := by
  let : Fact T.p.Prime := ⟨T.prime⟩
  let I : Ideal R := Ideal.span {(T.p : R)}
  let Q := R ⧸ I
  let red : R →+* Q := Ideal.Quotient.mk I
  let : CharP Q T.p := CharP.quotient _ T.p hp
  let U : FrobeniusCycle N W Q := T.map red
  have h_zero : MvPolynomial.map red
      (T.deepScale r (T.polyAction g (T.adjacentPairing s * f))) = 0 := by
    rw [T.map_deepScale, T.map_polyAction, map_mul, T.map_adjacentPairing,
      map_mul, U.polyAction_adjacentPairing, map_mul, U.deepScale_adjacentPairing,
      zero_mul]
  have h_coeff : red ((T.deepScale r (T.polyAction g (T.adjacentPairing s * f))).coeff d) = 0 := by
    simpa only [coeff_map, AddMonoidAlgebra.coeff_zero, Finsupp.coe_zero, Pi.zero_apply] using
      congrArg (fun f : MvPolynomial (Fin k × ZMod N) Q ↦ f.coeff d) h_zero
  exact Ideal.mem_span_singleton.1 ((Ideal.Quotient.eq_zero_iff_mem).1 h_coeff)

/-- The residual degree of the fixed-coordinate padding in each letter. -/
def pairingPadDegree (T : FrobeniusCycle N W R) (a : ℕ) (s t : ZMod N) : ℕ :=
  if t = s then a - T.P else if t = s + 1 then a - 1 else a

/-- The padding needed to place one adjacent pairing in degree `a` in every letter. -/
def pairingPadding (T : FrobeniusCycle N W R) (a : ℕ) (s : ZMod N) (b₀ : Fin k) :
    MvPolynomial (Fin k × ZMod N) R :=
  ∏ t : ZMod N, X (b₀, t) ^ T.pairingPadDegree a s t

/-- The exponent of the summand indexed by `b` in the padded adjacent pairing. -/
def pairingTermExponent (T : FrobeniusCycle N W R) (a : ℕ) (ha : T.P ≤ a)
    (s : ZMod N) (b₀ b : Fin k) : Exponents N k a := fun t ↦
  ⟨Finsupp.single b₀ (T.pairingPadDegree a s t) +
      if t = s then Finsupp.single b T.P else
        if t = s + 1 then Finsupp.single b 1 else 0, by
    rw [Finset.mem_finsuppAntidiag]
    refine ⟨?_, Finset.subset_univ _⟩
    have h_sum (i : Fin k) (n : ℕ) : ∑ j : Fin k, (Finsupp.single i n) j = n := by
      simp only [Finsupp.single_apply, Finset.sum_ite_eq, Finset.mem_univ, ite_true]
    have h1 : 1 ≤ a := ((by decide : 1 ≤ 5).trans T.five_le_P).trans ha
    by_cases hs : t = s
    · simp only [pairingPadDegree, ite_eq_left hs, Finsupp.coe_add, Pi.add_apply,
        Finset.sum_add_distrib, h_sum, Nat.sub_add_cancel ha]
    · by_cases hs' : t = s + 1
      · simp only [pairingPadDegree, ite_eq_right hs, ite_eq_left hs', Finsupp.coe_add, Pi.add_apply,
          Finset.sum_add_distrib, h_sum, Nat.sub_add_cancel h1]
      · simp only [pairingPadDegree, ite_eq_right hs, ite_eq_right hs', add_zero, h_sum]⟩

/-- An explicit integral row in the source's ordinary coefficient coordinates. -/
def adjacentPairingRow (T : FrobeniusCycle N W R) (a : ℕ) (ha : T.P ≤ a)
    (s : ZMod N) (b₀ : Fin k) : Exponents N k a → R :=
  ∑ b : Fin k, Pi.single (T.pairingTermExponent a ha s b₀ b) 1

omit [NeZero N] in
lemma pairingTermExponent_injective (T : FrobeniusCycle N W R) (a : ℕ) (ha : T.P ≤ a)
    (s : ZMod N) (b₀ : Fin k) :
    Function.Injective (T.pairingTermExponent a ha s b₀) := by
  intro b c h
  by_contra hbc
  have h_coeff := congrArg (fun β : Exponents N k a ↦ (β (s + 1)).val b) h
  simp only [pairingTermExponent, ite_eq_right (T.adjacent_ne s), ite_true,
    Finsupp.add_apply, Finsupp.single_eq_same, Finsupp.single_eq_of_ne hbc,
    add_zero] at h_coeff
  omega

/-- The pure fixed-coordinate monomial has coefficient exactly one. -/
lemma adjacentPairingRow_unit (T : FrobeniusCycle N W R) (a : ℕ) (ha : T.P ≤ a)
    (s : ZMod N) (b₀ : Fin k) :
    T.adjacentPairingRow a ha s b₀ (T.pairingTermExponent a ha s b₀ b₀) = 1 := by
  simp [adjacentPairingRow, Pi.single_apply, (T.pairingTermExponent_injective a ha s b₀).eq_iff]

lemma exponentOf_pairingTermExponent (T : FrobeniusCycle N W R)
    (a : ℕ) (ha : T.P ≤ a) (s : ZMod N) (b₀ b : Fin k) :
    exponentOf (T.pairingTermExponent a ha s b₀ b) =
      (∑ t : ZMod N, Finsupp.single (b₀, t) (T.pairingPadDegree a s t)) +
        Finsupp.single (b, s) T.P + Finsupp.single (b, s + 1) 1 := by
  have h_pad (c : Fin k) (t : ZMod N) :
      (∑ u : ZMod N, Finsupp.single (b₀, u) (T.pairingPadDegree a s u)) (c, t) =
        Finsupp.single b₀ (T.pairingPadDegree a s t) c := by
    simp only [Finset.sum_apply', Finsupp.single_apply, Prod.mk.injEq]
    by_cases hbc : b₀ = c
    · simp only [hbc, true_and, ite_true, Finset.sum_ite_eq', Finset.mem_univ]
    · simp only [hbc, false_and, ite_false, Finset.sum_const_zero]
  ext ⟨c, t⟩
  change (Finsupp.single b₀ (T.pairingPadDegree a s t) +
    if t = s then Finsupp.single b T.P else
      if t = s + 1 then Finsupp.single b 1 else 0) c = _
  simp only [Finsupp.add_apply, h_pad]
  rw [add_assoc]
  congr 1
  by_cases hs : t = s
  · subst t
    simp [Finsupp.single_apply, Prod.mk.injEq, Ne.symm (T.adjacent_ne s)]
  · by_cases hs' : t = s + 1
    · subst t
      simp [Finsupp.single_apply, Prod.mk.injEq, T.adjacent_ne s]
    · simp [Prod.mk.injEq, hs, hs']

lemma monomial_pairingTermExponent (T : FrobeniusCycle N W R)
    (a : ℕ) (ha : T.P ≤ a) (s : ZMod N) (b₀ b : Fin k) :
    monomial (exponentOf (T.pairingTermExponent a ha s b₀ b)) (1 : R) =
      (X (b, s) ^ T.P * X (b, s + 1)) * T.pairingPadding a s b₀ := by
  rw [T.exponentOf_pairingTermExponent, monomial_add_single, monomial_add_single,
    monomial_sum_one]
  simp only [← X_pow_eq_monomial, pow_one, pairingPadding]
  ring

/-- The explicit row is the ordinary coefficient vector of the padded pairing. -/
lemma polyOfCoeffs_adjacentPairingRow (T : FrobeniusCycle N W R)
    (a : ℕ) (ha : T.P ≤ a) (s : ZMod N) (b₀ : Fin k) :
    polyOfCoeffs (T.adjacentPairingRow a ha s b₀) =
      T.adjacentPairing s * T.pairingPadding a s b₀ := by
  simp only [adjacentPairingRow, map_sum]
  have h_single (b : Fin k) :
      polyOfCoeffs (Pi.single (T.pairingTermExponent a ha s b₀ b) (1 : R)) =
        monomial (exponentOf (T.pairingTermExponent a ha s b₀ b)) 1 := by
    simp [polyOfCoeffs, Pi.single_apply, apply_ite]
  simp_rw [h_single, T.monomial_pairingTermExponent]
  rw [← Finset.sum_mul]
  rfl

lemma deepScale_monomial (T : FrobeniusCycle N W R) (r : ℕ)
    (d : Fin k × ZMod N →₀ ℕ) (c : R) :
    T.deepScale r (monomial d c) =
      monomial d ((T.p : R) ^ d.weight (T.deepIndicator r) * c) := by
  rw [deepScale, aeval_monomial]
  simp [monomial_eq, Finsupp.prod_fintype, mul_pow,
    Finset.prod_mul_distrib, Finsupp.weight_eq_sum, ← pow_mul,
    Finset.prod_pow_eq_pow_sum, mul_assoc, mul_comm]

/-- Deep-variable scaling is the diagonal `p ^ depth` on coefficient columns. -/
lemma deepScale_polyOfCoeffs (T : FrobeniusCycle N W R) (r a : ℕ)
    (h : Exponents N k a → R) :
    T.deepScale r (polyOfCoeffs h) =
      polyOfCoeffs ((Matrix.diagonal fun β : Exponents N k a ↦
        (T.p : R) ^ T.depth k a r β) *ᵥ h) := by
  simp [polyOfCoeffs, T.deepScale_monomial, depth, Matrix.mulVec_diagonal]

/-- The adjacent-pair row, with the literal depth diagonal and the literal letter
representation, reads a multiple of `p` after every integral change of frame. -/
theorem adjacentPairingRow_deep_dvd (T : FrobeniusCycle N W R)
    (hp : ¬IsUnit (T.p : R)) (r a : ℕ) (ha : T.P ≤ a)
    (s : ZMod N) (b₀ : Fin k) (g : GL (Fin k) W) (β : Exponents N k a) :
    (T.p : R) ∣ ((Matrix.diagonal fun γ : Exponents N k a ↦
      (T.p : R) ^ T.depth k a r γ) *ᵥ
        (T.letterRep a g *ᵥ T.adjacentPairingRow a ha s b₀)) β := by
  have h := T.dvd_coeff_deepScale_polyAction_pairing_mul hp r s g
    (T.pairingPadding a s b₀) (exponentOf β)
  rw [← T.polyOfCoeffs_adjacentPairingRow a ha s b₀,
    T.polyAction_polyOfCoeffs, T.deepScale_polyOfCoeffs] at h
  simpa [polyOfCoeffs] using h

end New.FrobeniusCycle

end
